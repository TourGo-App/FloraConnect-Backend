# Optional local port. The health endpoint needs no secrets or database.
PORT=3001
# Optional comma-separated origin allowlist, replacing the built-in defaults:
# FRONTEND_ORIGINS=https://flora-connect-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173
# MongoDB connection string (local instance or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/floraconnect
