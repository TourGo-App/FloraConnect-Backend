# Optional local port. The health endpoint needs no secrets or database.
PORT=3001
# Local browser origins. Replace with HTTPS-only values when deploying to Vercel.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hosted allowlist supporting both frontend deployments (no trailing slashes):
# FRONTEND_ORIGINS=https://flora-connect-frontend.vercel.app,https://flora-connect-frontend-qemd.vercel.app
# Local development only: this localhost example cannot be used on Vercel.
# For Vercel set MONGODB_URI to your Atlas mongodb+srv:// URI in the BACKEND
# project Production environment variables, then redeploy. Never commit the real URI.
MONGODB_URI=mongodb://localhost:27017/floraconnect

# Optional verification mail adapter. Receives {to, subject, text} over HTTPS.
# VERIFICATION_EMAIL_WEBHOOK=https://your-private-mail-adapter.example/send
# VERIFICATION_EMAIL_WEBHOOK_TOKEN=configure-a-private-delivery-token
FRONTEND_URL=http://localhost:5173
# Develop backend verification links:
# FRONTEND_URL=https://flora-connect-frontend-qemd.vercel.app
# Main backend verification links:
# FRONTEND_URL=https://flora-connect-frontend.vercel.app
# Bootstrap variables are supplied only to the local seed command, never committed:
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
